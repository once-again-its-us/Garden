
---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p class="closing-line">A little universe, made with love.</p>

		<p class="copyright">
			&copy; {today.getFullYear()} A Little Universe for Malar.
			<br />
			Every little word belongs here.
		</p>

		<div class="footer-note">
			<span>Made with love, always.</span>
			<span class="heart">♥</span>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 4em 1em 3em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}

	.footer-content {
		max-width: 600px;
		margin: 0 auto;
	}

	.closing-line {
		font-family: Georgia, serif;
		font-size: 1.3rem;
		font-style: italic;
		color: rgb(var(--gray-dark));
		margin-bottom: 1.2em;
	}

	.copyright {
		font-size: 0.85rem;
		line-height: 1.8;
		opacity: 0.8;
	}

	.footer-note {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		margin-top: 2em;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}

	.heart {
		color: #c76b78;
		font-size: 1rem;
	}

</style>
