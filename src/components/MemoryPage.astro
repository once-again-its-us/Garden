
<div class="memory">
  <slot />
</div>

<style>
  .memory {
    --pink: #e99ab5;
    --ink: #765364;
    color: var(--ink);
    font-family: Georgia, serif;
    line-height: 1.95;
  }

  .memory :global(.hero) {
    text-align: center;
    padding: 3.5rem 1rem;
    background: linear-gradient(145deg, #fff0f5, #f9edf9, #fff8ed);
    border-radius: 24px;
    margin: 1.5rem 0 2rem;
  }

  .memory :global(.eyebrow) {
    letter-spacing: 3px;
    font-size: .7rem;
    color: #bd8299;
    text-transform: uppercase;
  }

  .memory :global(.hero h1) {
    font-size: clamp(2.2rem, 7vw, 4rem);
    line-height: 1.15;
    color: #a65e7d;
    font-weight: normal;
  }

  .memory :global(.hero p) {
    font-style: italic;
  }

  .memory :global(.letter) {
    max-width: 680px;
    margin: auto;
  }

  .memory :global(.divider) {
    text-align: center;
    color: #d68ca8;
    letter-spacing: 8px;
    margin: 2.5rem 0;
  }

  .memory :global(.highlight) {
    background: #fff0f5;
    padding: 1.2rem 1.5rem;
    border-left: 3px solid #e99ab5;
    border-radius: 0 14px 14px 0;
    font-style: italic;
  }

  .memory :global(.memory-card) {
    background: #fff4f7;
    padding: 1.5rem;
    border-radius: 18px;
    text-align: center;
    margin: 1.5rem 0;
  }

  .memory :global(.reveal) {
    border: 1px solid #efd0dc;
    padding: 1rem 1.2rem;
    border-radius: 14px;
    margin: 1rem 0;
    background: #fffafb;
  }

  .memory :global(.reveal summary) {
    cursor: pointer;
    color: #a65e7d;
    font-weight: bold;
  }

  .memory :global(.heart-button) {
    display: block;
    margin: 1.5rem auto;
    padding: 13px 25px;
    border: none;
    border-radius: 30px;
    background: #e99ab5;
    color: white;
    font-size: 1rem;
    cursor: pointer;
    transition: transform .2s, background .2s;
  }

  .memory :global(.heart-button:hover) {
    transform: translateY(-3px);
    background: #cf7899;
  }

  .memory :global(.heart-message) {
    text-align: center;
    min-height: 50px;
    color: #a65e7d;
    font-style: italic;
  }

  .memory :global(.ending) {
    text-align: center;
    padding: 3rem 1rem;
    background: linear-gradient(145deg, #fff1f5, #f9edf9);
    border-radius: 24px;
    margin-top: 3rem;
  }

  .memory :global(.ending h2) {
    color: #a65e7d;
    font-weight: normal;
  }

  .memory :global(.signature) {
    font-style: italic;
    color: #bb7995;
  }

  .memory :global(.floating-hearts) {
    font-size: 1.4rem;
    letter-spacing: 12px;
  }
</style>

<script>
  const messages = [
    'This little memory is yours to keep forever, ma. ♡',
    'One night, a million feelings, and my favourite girl. 🌙',
    'If I could relive one moment, I would find you again. 💗',
    'Our little universe. Just you and me. ✨',
    'I love you more than these little words can ever hold. 🫶'
  ];

  document.querySelectorAll('.memory').forEach((memory) => {
    const button = memory.querySelector('.heart-button');
    const message = memory.querySelector('.heart-message');

    if (!button || !message) return;

    let index = 0;

    button.addEventListener('click', () => {
      message.textContent = messages[index % messages.length];
      button.textContent = 'Saved with love ♥';
      index++;
    });
  });
</script>
