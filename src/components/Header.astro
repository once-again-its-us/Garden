
---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="brand">
			<h2>
				<a href="/">{SITE_TITLE}</a>
			</h2>
			<span class="tagline">A little corner of the universe</span>
		</div>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Journal</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 2em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		min-height: 85px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2em;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	h2 {
		margin: 0;
		font-family: Georgia, serif;
		font-size: 1.4rem;
		font-weight: 500;
		letter-spacing: -0.04em;
	}

	h2 a {
		color: var(--black);
		text-decoration: none;
	}

	.tagline {
		font-family: Georgia, serif;
		font-size: 0.75rem;
		font-style: italic;
		color: rgb(var(--gray));
		letter-spacing: 0.02em;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}

	.internal-links a {
		padding: 0.7em 0;
		color: var(--black);
		font-size: 0.9rem;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.internal-links a:hover {
		color: #b76e79;
		border-bottom-color: #b76e79;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}

		nav {
			min-height: 75px;
			flex-wrap: wrap;
			padding: 1em 0;
			gap: 1em;
		}

		.internal-links {
			gap: 1em;
		}
	}
</style>
